---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Home" showNav={true} activeNav="home">
  <div class="view active">
    <h2 class="page-title">Olá, <span id="homeUserName"></span>!</h2>

    <div id="homeJogoBanner" class="banner-jogo hidden">
      JOGO HOJE
    </div>

    <div class="section-header mt-4 mb-2">
      <h3 class="section-label">Eventos de Hoje</h3>
    </div>
    <div id="homeEventosContainer"></div>

    <div class="section-header mt-4 mb-2">
      <h3 class="section-label">Últimos Comunicados</h3>
      <a href="#" onclick="navigate('comunicados')" class="section-link">Ver todos →</a>
    </div>
    <div id="homeComunicadosContainer"></div>

    <div id="homeQuickActions" class="quick-actions mt-4 hidden">
      <button class="btn btn-secondary btn-sm" onclick="openModal('modalComunicado')">+ Comunicado</button>
      <button class="btn btn-secondary btn-sm" onclick="openModal('modalEvento')">+ Evento</button>
    </div>
  </div>
</Layout>
