---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Jogos" showNav={true} activeNav="jogos">
  <div class="view active">
    <h2 class="page-title mb-4">Jogos</h2>
    <div class="tabs">
      <div class="tab active" onclick="switchJogosTab('convocatorias')" id="tabConvocatorias">Convocatórias</div>
      <div class="tab" onclick="switchJogosTab('resultados')" id="tabResultados">Resultados</div>
    </div>
    
    <div id="jogosConvocatoriasContainer"></div>
    <div id="jogosResultadosContainer" class="hidden"></div>
    
    <button id="btnNovaConvocatoria" class="btn btn-primary mt-4 hidden" onclick="openModalConvocatoria()">Nova Convocatória</button>
    
  </div>
</Layout>
