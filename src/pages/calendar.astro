---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Calendar" showNav={true} activeNav="calendar">
  <div class="view active">
    <div class="d-flex justify-between align-center mb-4">
      <h2 class="page-title no-mb">Calendário</h2>
      <div class="month-nav">
        <button class="icon-btn" onclick="changeMonth(-1)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
        <span id="calendarMonthYear" class="month-label">Abril 2026</span>
        <button class="icon-btn" onclick="changeMonth(1)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
    
    <div class="card card-calendar">
      <div class="calendar-header">
        <div>D</div><div>S</div><div>T</div><div>Q</div><div>Q</div><div>S</div><div>S</div>
      </div>
      <div id="calendarGrid" class="calendar-grid"></div>
    </div>

    <h3 class="section-label mb-2 mt-4" id="selectedDateLabel">Eventos</h3>
    <div id="calendarDayEvents"></div>
    
    <button id="btnNovoEvento" class="btn-fab hidden" onclick="openModal('modalEvento')">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    
  </div>
</Layout>
