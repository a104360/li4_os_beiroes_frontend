---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Register" showNav={false} activeNav="register">
  <div class="view active">
    <div class="d-flex align-center gap-2 mb-4 mt-2">
      <button class="icon-btn" onclick="navigate('login')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
      <h1 class="bebas" style="font-size:32px;">Criar Conta</h1>
    </div>
    <div class="card">
      <form id="registerForm" onsubmit="handleRegister(event)">
        <div class="form-group">
          <label>Nome Completo</label>
          <input type="text" id="regNome" class="form-control" required placeholder="O teu nome...">
        </div>
        <div class="form-group">
          <label>Contacto Telefónico</label>
          <input type="tel" id="regContacto" class="form-control" required placeholder="910000000">
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="regPassword" class="form-control" required placeholder="Mínimo 6 caracteres">
        </div>
        <div class="form-group">
          <label>Confirmação de Password</label>
          <input type="password" id="regPasswordConfirm" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Função no Clube</label>
          <select id="regRole" class="form-control" required>
            <option value="jogador">Jogador</option>
            <option value="treinador">Treinador</option>
            <option value="presidente">Presidente</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Registar Conta</button>
      </form>
    </div>
    
  </div>
</Layout>
