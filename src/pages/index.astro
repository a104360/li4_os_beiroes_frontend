---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Login" showNav={false} activeNav="login">
  <div class="view active">
    <div class="text-center mb-4 mt-4">
      <svg viewBox="0 0 24 24" style="width:80px;height:80px;fill:url(#grad);margin:0 auto;">
        <defs><linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:var(--color-primary);stop-opacity:1" /><stop offset="100%" style="stop-color:var(--color-primary-hover);stop-opacity:1" /></linearGradient></defs>
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="10" r="3" fill="var(--color-bg)"/>
      </svg>
      <h1 class="bebas" style="font-size:46px;color:var(--color-primary);margin-top:16px;">O CADERNO DO QUIM</h1>
      <p class="text-muted" style="font-weight:500;">Sport Clube Os Beirões</p>
    </div>
    <div class="card">
      <form id="loginForm" onsubmit="handleLogin(event)">
        <div class="form-group">
          <label>Contacto Telefónico</label>
          <input type="tel" id="loginContacto" class="form-control" placeholder="Ex: 910000000" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" id="loginPassword" class="form-control" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Entrar</button>
      </form>
    </div>
    <div class="text-center mt-4 mb-4">
      <a href="#" onclick="navigate(\'register\')" style="color:var(--color-text-muted);font-weight:600;text-decoration:none;">Não tens conta? <span style="color:var(--color-primary);">Regista-te</span></a>
    </div>
    <hr style="border:none;border-top:1px solid var(--color-border);margin: 24px 0;">
    <div class="text-center">
      <p class="text-muted mb-2" style="font-size:14px;font-weight:600;">Modo Rápido (Demonstração)</p>
      <button class="btn btn-auto-login" onclick="handleAutoLogin()">⚡ Login Automático Rápido</button>
    </div>
    
  </div>
</Layout>
