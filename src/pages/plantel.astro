---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Plantel" showNav={true} activeNav="plantel">
  <div class="view active">
    <div class="d-flex align-center gap-2 mb-4">
      <button class="icon-btn" onclick="navigate('perfil')"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
      <h2 class="bebas" style="font-size:32px;margin-top:4px;">GESTÃO DO PLANTEL</h2>
    </div>
    
    <div class="form-group relative" style="position:relative;display:inline-block;width:100%;">
      <input type="text" id="searchJogador" class="form-control" style="padding-left:40px;" placeholder="Procurar jogador..." oninput="renderPlantel()">
      <svg style="position:absolute;left:12px;top:13px;color:var(--color-text-muted);" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </div>
    
    <div id="plantelContainer"></div>
    <button id="btnNovoJogador" class="btn-fab" onclick="openModal('modalJogador')">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    
  </div>
</Layout>
