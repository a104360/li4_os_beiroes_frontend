---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Perfil" showNav={true} activeNav="perfil">
  <div class="view active">
    <h2 class="bebas mb-4" style="font-size:32px;">O MEU PERFIL</h2>
    
    <div class="card text-center" style="border-top: 4px solid var(--color-primary);">
      <div class="avatar avatar-lg mb-3 mt-2" id="perfilAvatar"></div>
      <h3 id="perfilName" style="font-size:24px;margin-bottom:4px;"></h3>
      <div class="badge badge-gray mb-2" id="perfilRole"></div>
      <p class="text-muted" id="perfilContacto"></p>
    </div>
    
    <div class="d-flex justify-between align-center mb-2 mt-4">
      <h3 class="bebas text-muted" style="font-size:20px;">A MINHA ATIVIDADE</h3>
    </div>
    <div class="card" style="display:flex;text-align:center;padding:var(--space-4) 0;">
      <div style="flex:1;border-right:1px solid var(--color-border);">
        <div style="font-size:28px;font-family:'Bebas Neue';color:var(--color-primary);">12</div>
        <div style="font-size:12px;color:var(--color-text-muted);font-weight:600;text-transform:uppercase;">Treinos</div>
      </div>
      <div style="flex:1;border-right:1px solid var(--color-border);">
        <div style="font-size:28px;font-family:'Bebas Neue';color:var(--color-primary);">5</div>
        <div style="font-size:12px;color:var(--color-text-muted);font-weight:600;text-transform:uppercase;">Jogos</div>
      </div>
      <div style="flex:1;">
        <div style="font-size:28px;font-family:'Bebas Neue';color:var(--color-primary);">85%</div>
        <div style="font-size:12px;color:var(--color-text-muted);font-weight:600;text-transform:uppercase;">Assiduidade</div>
      </div>
    </div>
    
    <div class="d-flex justify-between align-center mb-2 mt-4">
      <h3 class="bebas text-muted" style="font-size:20px;">DEFINIÇÕES</h3>
    </div>
    <div class="card" style="padding:0;overflow:hidden;">
      <div id="perfilGestaoPlantel" class="hidden">
        <a href="#" onclick="navigate('plantel')" class="d-flex justify-between align-center" style="padding:var(--space-4);text-decoration:none;color:var(--color-text);border-bottom:1px solid var(--color-border);transition:0.2s;">
          <div class="d-flex align-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span style="font-weight:600;">Gestão do Plantel</span>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </div>
      <div id="perfilDocs" class="hidden">
        <div class="d-flex justify-between align-center" style="padding:var(--space-4);border-bottom:1px solid var(--color-border);">
          <div class="d-flex align-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            <span style="font-weight:600;color:var(--color-text-muted);">Documentos (Em breve)</span>
          </div>
        </div>
      </div>
      <a href="#" onclick="handleLogout()" class="d-flex align-center justify-between" style="padding:var(--space-4);text-decoration:none;color:var(--color-error);font-weight:600;background:rgba(239, 68, 68, 0.05);">
        <div class="d-flex align-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Terminar Sessão
        </div>
      </a>
    </div>
    
  </div>
</Layout>
