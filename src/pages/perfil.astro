---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Os Beirões - Perfil" showNav={true} activeNav="perfil">
  <div class="view active">
    <h2 class="page-title">O Meu Perfil</h2>

    <div class="card card-profile">
      <div class="avatar avatar-lg" id="perfilAvatar"></div>
      <h3 class="profile-name" id="perfilName"></h3>
      <div class="badge badge-gray" id="perfilRole"></div>
      <p class="text-muted mt-2" id="perfilContacto"></p>
    </div>

    <h3 class="section-label mt-4 mb-2">A Minha Atividade</h3>
    <div class="stats-row card">
      <div class="stat-cell" id="statTreinos">
        <span class="stat-value">12</span>
        <span class="stat-label">Treinos</span>
      </div>
      <div class="stat-cell" id="statJogos">
        <span class="stat-value">5</span>
        <span class="stat-label">Jogos</span>
      </div>
      <div class="stat-cell" id="statAssiduidade">
        <span class="stat-value">85%</span>
        <span class="stat-label">Assiduidade</span>
      </div>
    </div>

    <h3 class="section-label mt-4 mb-2">Definições</h3>
    <div class="card card-menu">
      <div id="perfilGestaoPlantel" class="hidden">
        <a href="#" onclick="navigate('plantel')" class="menu-row">
          <div class="d-flex align-center gap-3">
            <svg class="menu-icon menu-icon-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="menu-label">Gestão do Plantel</span>
          </div>
          <svg class="menu-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      </div>
      <div id="perfilDocs" class="hidden">
        <div class="menu-row menu-row-disabled">
          <div class="d-flex align-center gap-3">
            <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span class="menu-label menu-label-muted">Documentos <span class="badge badge-gray badge-xs">Em breve</span></span>
          </div>
        </div>
      </div>
      <a href="#" onclick="handleLogout()" class="menu-row menu-row-danger">
        <div class="d-flex align-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Terminar Sessão
        </div>
      </a>
    </div>
  </div>
</Layout>
