---
import { ClientRouter } from 'astro:transitions';
import Modals from '../components/Modals.astro';

interface Props {
	title: string;
	showNav?: boolean;
    activeNav?: string;
}

const { title, showNav = true, activeNav = 'home' } = Astro.props;
---

<!doctype html>
<html lang="pt">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="O Caderno do Quim - Os Beirões" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<ClientRouter />
        <link rel="stylesheet" href="/css/style.css" />
        <script is:inline src="/js/app.js"></script>
	</head>
	<body>
  <a class="skip-link" href="#app">Saltar para o conteudo</a>
  <div class="app-bg" aria-hidden="true">
      <div class="bg-orb orb-1"></div>
      <div class="bg-orb orb-2"></div>
      <div class="bg-orb orb-3"></div>
  </div>
        <div id="fullLoader" class="full-page-loader hidden">
          <div class="spinner"></div>
          <h2 class="bebas">OS BEIRÕES</h2>
        </div>

        <div class="toast-container" id="toastContainer"></div>

        {showNav ? (
          <div class="app-shell">
            <nav class="sidebar" id="bottomNav">
              <div class="sidebar-logo">
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="10" r="3" fill="var(--color-bg)"/></svg>
                OS BEIRÕES
              </div>
              <a href="/home" class={`nav-item ${activeNav === 'home' ? 'active' : ''}`} id="nav-home">
                <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Início
              </a>
              <a href="/calendar" class={`nav-item ${activeNav === 'calendar' ? 'active' : ''}`} id="nav-calendar">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Calendário
              </a>
              <a href="/jogos" class={`nav-item ${activeNav === 'jogos' ? 'active' : ''}`} id="nav-jogos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                Jogo
              </a>
              <a href="/boleias" class={`nav-item ${activeNav === 'boleias' ? 'active' : ''}`} id="nav-boleias">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><circle cx="17" cy="17" r="2"/><circle cx="7" cy="17" r="2"/></svg>
                Boleias
              </a>
              <a href="/viaturas" class={`nav-item ${activeNav === 'viaturas' ? 'active' : ''}`} id="nav-viaturas">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/>
                  <circle cx="7" cy="17" r="2"/>
                  <path d="M9 17h6"/>
                  <circle cx="17" cy="17" r="2"/>
                </svg>
                Viaturas
              </a>
              <a href="/perfil" class={`nav-item ${activeNav === 'perfil' ? 'active' : ''}`} id="nav-perfil">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Perfil
              </a>
            </nav>

            <div class="app-body">
              <header class="app-header" id="appHeader">
                <div class="header-logo">
                  <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="10" r="3" fill="var(--color-bg)"/></svg>
                  <div class="header-title">OS BEIRÕES</div>
                </div>
                <div class="header-actions">
                  <button class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Alternar tema escuro/claro">
                    <svg id="themeIcon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                  </button>
                </div>
              </header>

              <main id="app">
                <slot />
              </main>
            </div>
          </div>
        ) : (
          <main id="app" class="app-no-nav">
            <slot />
          </main>
        )}

        <Modals />
        
        <script is:inline>
            const MOON_SVG = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
            const SUN_SVG = '<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>';

            function syncThemeIcon() {
                const icon = document.getElementById('themeIcon');
                if (!icon) return;
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                icon.innerHTML = isDark ? SUN_SVG : MOON_SVG;
                const btn = document.getElementById('themeToggleBtn');
                if (btn) btn.setAttribute('aria-label', isDark ? 'Mudar para tema claro' : 'Mudar para tema escuro');
            }

            document.addEventListener('astro:page-load', () => {
                const path = window.location.pathname.replace('/', '') || 'login';
                if(window.renderView) window.renderView(path === '' ? 'login' : path);
                syncThemeIcon();
                const origToggle = window.toggleTheme;
                if (origToggle) {
                    window.toggleTheme = function() {
                        origToggle();
                        syncThemeIcon();
                    };
                }
            });
        </script>
	</body>
</html>